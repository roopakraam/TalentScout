# Data: the Kaggle CSVs are large and must not be committed (see data/README.md)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX build products (the compiled PDFs are kept)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc

# Scratch
tmp/
*.tmp

# Local-only folders (not pushed)
paper/
report/
docs/
data/
tips.txt
